// MARK: - Versioning

// Version
MARKETING_VERSION = 1.0

// Build
CURRENT_PROJECT_VERSION = 1

// MARK: - Product

APP_BUNDLE_ID_PREFIX = com.kamilgomolka
PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID_PREFIX).$(TARGET_NAME)

// MARK: - Code Signing

CODE_SIGN_STYLE = Automatic

// MARK: - Platform

SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2

// MARK: - Swift

SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_STRICT_MEMORY_SAFETY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// MARK: - Assets

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// MARK: - Info.plist

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = AppleUICatalogUIKitCode/SupportingFiles/Info.plist
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchStoryboardName = LaunchScreen
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

// MARK: - Local Overrides

// DEVELOPMENT_TEAM is intentionally absent from version control so a clone builds
// on the Simulator without signing changes. See Config/Local.xcconfig.example.
#include? "./Local.xcconfig"
